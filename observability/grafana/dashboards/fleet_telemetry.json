          "lon": -46.2,
          "zoom": 6
        },
        "basemap": {
          "type": "osm-standard",
          "name": "OpenStreetMap",
          "config": {}
        },
        "layers": [
          {
            "type": "markers",
            "name": "Caminhões Ativos",
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "config": {
              "style": {
                "size": { "fixed": 7 },
