      "id": 1,
      "title": "🗺️ Mapa da Frota em Tempo Real (Última Posição por Caminhão)",
      "type": "geomap",
      "gridPos": { "h": 14, "w": 16, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "fleet-postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (truck_id) truck_id, latitude, longitude, speed_kmh, cargo_temp_c, fuel_level_pct, status, event_timestamp FROM truck_telemetry ORDER BY truck_id, event_timestamp DESC;"
        }
      ],
      "options": {
        "view": {
          "id": "coords",
